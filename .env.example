# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# NOTE (2026-08-17): llama-3.1-8b-instant and llama-3.3-70b-versatile were
# deprecated by Groq on 2026-08-16 and will 404 ("model_not_found") on most
# accounts now. Defaults below use only openai/gpt-oss-120b and
# openai/gpt-oss-20b. If you hit model_not_found again later, check
# console.groq.com/docs/deprecations — Groq's lineup changes often.

# Model used by job_analyzer, cv_matcher, interview_prep, and report_writer
# (the content-generating agents where reasoning quality matters most).
# openai/gpt-oss-120b: open-weight MoE reasoning model, native JSON-schema
# structured outputs, ~500 tok/s, $0.15/$0.60 per 1M input/output tokens.
GROQ_MODEL=openai/gpt-oss-120b
# Fallback if GROQ_MODEL gets rate-limited or errors out after retrying.
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# Model used by the supervisor for its routing decision — a cheap
# classification-style task that doesn't need the big model.
# openai/gpt-oss-20b: ~1000 tok/s, $0.075/$0.30 per 1M tokens.
GROQ_FAST_MODEL=openai/gpt-oss-20b
# Fallback if GROQ_FAST_MODEL gets rate-limited or errors out after retrying.
GROQ_FAST_MODEL_FALLBACK=openai/gpt-oss-120b

# Model used by the Scorer agent (agents/scorer.py) — a dedicated,
# reasoning_effort="high" pass that computes a weighted, per-requirement
# score instead of a single eyeballed number. Same models as GROQ_MODEL by
# default (Groq's other "reasoning" models change availability often —
# see the deprecation note above), just with reasoning cranked up.
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_REASONING_MODEL_FALLBACK=openai/gpt-oss-20b

# Other current Groq options worth knowing about (see console.groq.com/docs/models):
#   qwen/qwen3.6-27b          — preview only, not production-ready yet; also
#                                the only vision-capable model, used automatically
#                                for screenshot uploads (file_parsing.py)

# --- Langfuse (optional) ----------------------------------------------------
# Leave these unset to run with no tracing. To enable: sign up for the free
# "Hobby" tier at https://cloud.langfuse.com, create a project, and paste
# its API keys below.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region (default): https://cloud.langfuse.com
# US region: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
